{
    "name": "daniel-km/omeka-s-module-meta-tags",
    "type": "omeka-s-module",
    "description": "Module for Omeka S: Adds Open Graph and Twitter cards tags inside the header of all pages and resources to display them automatically in social networks.",
    "keywords": [
        "Omeka S",
        "Omeka S module",
        "social network",
        "metadata",
        "tags"
    ],
    "license": "CECILL-2.1",
    "homepage": "https://gitlab.com/Daniel-KM/Omeka-S-module-MetaTags",
    "authors": [
        {
            "name": "Daniel Berthereau",
            "email": "Daniel.packagist@Berthereau.net"
        }
    ],
    "support": {
        "issues": "https://gitlab.com/Daniel-KM/Omeka-S-module-MetaTags/-/work_items",
        "forum": "https://forum.omeka.org/"
    },
    "_require (not set until Omeka S merges PR #2432)": {
        "omeka/omeka-s": "^4.0",
        "daniel-km/omeka-s-module-common": "*"
    },
    "autoload": {
        "psr-4": {
            "MetaTags\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MetaTagsTest\\": "tests/MetaTagsTest/"
        }
    },
    "extra": {
        "installer-name": "MetaTags"
    }
}
